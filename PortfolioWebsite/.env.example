SESSION_SECRET=replace-with-a-long-random-string
PORTFOLIO_ADMIN_TOKEN=replace-with-a-separate-random-admin-token

# Firebase publishing (public web app identifiers; never a service-account key).
# Leave blank for browser-only editing without online publication.
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_AUTH_DOMAIN=
# Set to 1 on any hosted runtime. Legacy local accounts/files remain on your PC.
PORTFOLIO_DISABLE_LOCAL_EDITOR=0
# For local Firebase development, use GOOGLE_APPLICATION_CREDENTIALS pointing to
# a credential file outside this repository, or use the isolated emulator tests.
